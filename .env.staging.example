# Staging certification environment — copy to .env.staging (never commit).
# Use TEST/STAGING credentials only. Never use production live keys.

NODE_ENV=production

# --- Database (docker-compose.staging.yml defaults) ---
DATABASE_PROVIDER=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/atelier_ai_test
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/atelier_ai_test

# --- Redis ---
REDIS_URL=redis://localhost:6379
REDIS_URL_TEST=redis://localhost:6379
RATE_LIMIT_PROVIDER=redis
QUEUE_PROVIDER=bullmq

# --- Storage (dedicated staging bucket) ---
STORAGE_PROVIDER=s3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# --- Stripe TEST mode only ---
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_STARTER_PRICE_ID=price_
STRIPE_PRO_PRICE_ID=price_
STRIPE_BUSINESS_PRICE_ID=price_

# --- AI providers (staging keys) ---
GEMINI_API_KEY=
VIDEO_PROVIDER_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_VIDEO_MODEL=veo-2.0-generate-001

# --- Auth & URLs ---
AUTH_SECRET=
AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
STAGING_BASE_URL=http://localhost:3000
STAGING_ENV=staging

# --- Playwright E2E accounts (seed with PLAYWRIGHT_SEED=true) ---
PLAYWRIGHT_BASE_URL=http://localhost:3000
PLAYWRIGHT_TEST_EMAIL=playwright-user@test.local
PLAYWRIGHT_TEST_PASSWORD=
PLAYWRIGHT_ADMIN_TEST_EMAIL=playwright-admin@test.local
PLAYWRIGHT_ADMIN_TEST_PASSWORD=
PLAYWRIGHT_SUSPENDED_TEST_EMAIL=playwright-suspended@test.local
PLAYWRIGHT_SUSPENDED_TEST_PASSWORD=
PLAYWRIGHT_SEED=true

# --- Soak (run only after all checks pass) ---
SOAK_DURATION_HOURS=24
SOAK_INTERVAL_SECONDS=60

# --- GitHub Actions secrets (never commit values) ---
# Map these in Settings → Secrets and variables → Actions:
#   STAGING_AWS_ACCESS_KEY_ID      → AWS_ACCESS_KEY_ID
#   STAGING_AWS_SECRET_ACCESS_KEY  → AWS_SECRET_ACCESS_KEY
#   STAGING_AWS_S3_BUCKET          → AWS_S3_BUCKET
#   STAGING_AWS_REGION             → AWS_REGION (optional)
#   STAGING_STRIPE_SECRET_KEY      → STRIPE_SECRET_KEY (sk_test_* only)
#   STAGING_STRIPE_WEBHOOK_SECRET  → STRIPE_WEBHOOK_SECRET
#   STAGING_STRIPE_STARTER_PRICE_ID → STRIPE_STARTER_PRICE_ID (optional)
#   STAGING_GEMINI_API_KEY         → GEMINI_API_KEY / VIDEO_PROVIDER_API_KEY
#
# Repository variable (Settings → Variables):
#   STAGING_BASE_URL               → deployed staging HTTPS URL (required for 24h soak)
