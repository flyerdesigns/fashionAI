# Database
# Provider: json (default, local dev) | postgres (production)
DATABASE_PROVIDER=json
DATABASE_URL=
# Dedicated PostgreSQL database for integration tests (never use production)
DATABASE_URL_TEST=
# Dedicated Redis instance for rate-limit integration tests
REDIS_URL_TEST=

# Cloud Storage
# Provider: local (default, local dev) | s3 (production)
STORAGE_PROVIDER=local
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
# Optional — for MinIO, LocalStack, or S3-compatible endpoints
AWS_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=

# AI Image Generation (server-side only — never expose to browser)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
DEFAULT_IMAGE_PROVIDER=gemini

# Generation worker (local development)
# Run in a separate terminal: npm run worker:generation
GENERATION_IMAGE_TIMEOUT_MS=120000
GENERATION_WORKER_POLL_MS=2000
GENERATION_MAX_CONCURRENCY=1

# Credits (server-side only)
CREDITS_SIGNUP_BONUS=100
CREDITS_PER_IMAGE=5
CREDITS_PER_REGENERATION=5
CREDITS_PER_RETRY=5
CREDIT_RESERVATION_TIMEOUT_MS=7200000

# Stripe (server-side only — never expose to browser)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=

# App URL (checkout success/cancel redirects)
APP_URL=http://localhost:3000

# AI Video Generation (server-side only — never expose to browser)
VIDEO_PROVIDER=gemini_veo
VIDEO_PROVIDER_API_KEY=
GEMINI_VIDEO_MODEL=veo-2.0-generate-001
VIDEO_GENERATION_TIMEOUT_MS=600000
VIDEO_WORKER_POLL_MS=3000
VIDEO_PROVIDER_POLL_MS=10000
VIDEO_MAX_ATTEMPTS=2
CREDITS_VIDEO_5_SEC=25
CREDITS_VIDEO_10_SEC=40
CREDITS_VIDEO_15_SEC=60

# Legacy aliases (optional — VIDEO_PROVIDER_API_KEY takes precedence)
AI_VIDEO_API_KEY=
AI_VIDEO_API_URL=

# Authentication (Auth.js / NextAuth v5)
AUTH_SECRET=
AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Migration policy for existing users
MIGRATE_CREDIT_SIGNUP_BONUS=false

# Logging
LOG_LEVEL=info

# Observability (Sentry — optional; leave SENTRY_DSN empty to disable)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_ENVIRONMENT=

# Rate limiting
# Provider: memory (default, single-instance dev) | redis (production multi-instance)
RATE_LIMIT_PROVIDER=memory
REDIS_URL=
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_GENERATION_PER_MINUTE=10
RATE_LIMIT_VIDEO_PER_MINUTE=5
RATE_LIMIT_BILLING_PER_MINUTE=10
RATE_LIMIT_DEFAULT_PER_MINUTE=120

# Admin (comma-separated emails auto-promoted to admin on signup)
ADMIN_EMAILS=

# Job queue (local = DB polling only, bullmq = Redis wake signals + DB polling)
QUEUE_PROVIDER=local

# Worker heartbeat stale threshold (ms)
WORKER_HEARTBEAT_STALE_MS=60000

# --- Playwright E2E (staging/CI — never use production credentials) ---
PLAYWRIGHT_BASE_URL=http://localhost:3000
PLAYWRIGHT_TEST_EMAIL=
PLAYWRIGHT_TEST_PASSWORD=
PLAYWRIGHT_ADMIN_TEST_EMAIL=
PLAYWRIGHT_ADMIN_TEST_PASSWORD=
PLAYWRIGHT_SUSPENDED_TEST_EMAIL=
PLAYWRIGHT_SUSPENDED_TEST_PASSWORD=
PLAYWRIGHT_SEED=true

# --- Staging verification ---
STAGING_BASE_URL=
STAGING_ENV=staging
STAGING_TEST_USER_ID=
STAGING_VALIDATE_PRODUCTION=false

# Soak test
SOAK_DURATION_HOURS=24
SOAK_INTERVAL_SECONDS=60
SOAK_RUN_GENERATION_CHECK=false
